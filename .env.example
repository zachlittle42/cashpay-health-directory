# Never commit actual credentials. Configure production in the existing Vercel project.
# See docs/growth-measurement.md and docs/referral-partner-launch.md.

# Existing PostHog project configuration (public project key, not personal API key).
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=

# Paused for the September growth release. Enable only after the account's
# Enhanced Measurement is disabled and the explicit event transport is verified.
NEXT_PUBLIC_ENABLE_GOOGLE_ANALYTICS=false
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# Operational contact delivery. Both required values must be configured before
# inquiry/email inputs appear. Sender domain must be verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=VitalityScout <notifications@vitalityscout.com>

# Only URLs issued by approved US ED partner programs. Empty means direct links.
# These affect prerendered pages: rebuild after changing them.
ED_HIMS_REFERRAL_URL=
ED_RO_REFERRAL_URL=
ED_BLUECHEW_REFERRAL_URL=
ED_LEMONAID_REFERRAL_URL=
